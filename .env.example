# Telegram bot token from @BotFather
BOT_TOKEN=replace_with_your_bot_token

# Fixed owner ID requested for /restart
OWNER_ID=7728424218

# Render sets this automatically. For local use, leave empty and polling will be used.
RENDER_EXTERNAL_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=10000

# Checker settings
CHECK_URL=https://api.ipify.org?format=json
# Optional header echo endpoint. Leave empty to skip anonymity header probing.
HEADER_ECHO_URL=
CHECK_TIMEOUT_SECONDS=8
CHECK_RETRIES=1
CHECK_CONCURRENCY=100
PROGRESS_UPDATE_SECONDS=1.2
WORKER_COUNT=2

# Runtime data
DATA_DIR=data
WELCOME_IMAGE=assets/welcome.png
LOG_LEVEL=INFO
